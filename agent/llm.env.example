# Non-secret example only. Hermes supplies the real key to the worker service.
ANTHROPIC_API_KEY=<dedicated-anthropic-api-key>
# Used only when a persona omits llm_model; every fleet persona is explicit.
GEN2B_LLM_MODEL=claude-haiku-5-5
# Missing persona llm_route defaults to anthropic (no route env var).
# Native endpoint: https://api.anthropic.com
# Native thinking: adaptive; output_config.effort: low.
# GEN2B_LLM_BASE/KEY/REASONING_EFFORT apply only to legacy routes.
