# Non-secret example. Gateway credentials also support unchanged audio routes.
GEN2B_BASE=https://ai-kz.gen2b.ai/v1
GEN2B_KEY=<gen2b-gateway-api-key>
GEN2B_LLM_MODEL=gemini-2.5-flash
GEN2B_LLM_REASONING_EFFORT=none
# Missing persona llm_route defaults to gateway (no route env var).
# Optional explicit anthropic route only:
# ANTHROPIC_API_KEY=<dedicated-anthropic-api-key>
# Native Haiku thinking is disabled; no output_config.effort is injected.
